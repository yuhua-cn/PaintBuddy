@echo off
REM ============================================================
REM  PaintingBuddy BETA build script (MSVC x64)
REM
REM  Produces the tester-facing release build. It is identical to
REM  build.bat EXCEPT that it defines PB_BETA, which compiles in the
REM  first-run cleanup in src\main.cpp:
REM
REM    On first launch the beta exe moves the whole
REM    %LOCALAPPDATA%\PaintingBuddy folder (logs, config, event
REM    streams, screen-recording cache left over from an earlier
REM    build) into the Recycle Bin, then recreates it.
REM
REM  The regular build.bat NEVER defines PB_BETA, so the official
REM  binary does not contain that code at all and cannot delete
REM  anything.
REM
REM  Usage:  build_beta.bat          incremental
REM          build_beta.bat rebuild  full rebuild
REM
REM  NOTE: keep this file ASCII-only, and avoid parenthesized
REM  code blocks: %WindowsSdkDir% contains "(x86)" and cmd.exe
REM  mis-parses unbalanced parens inside a block.
REM ============================================================
setlocal EnableDelayedExpansion
cd /d "%~dp0"

set "VSWHERE=%ProgramFiles(x86)%\Microsoft Visual Studio\Installer\vswhere.exe"
if not exist "%VSWHERE%" goto :no_vswhere
for /f "usebackq delims=" %%i in (`"%VSWHERE%" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath`) do set "VSPATH=%%i"
if not defined VSPATH goto :no_vswhere
call "%VSPATH%\VC\Auxiliary\Build\vcvars64.bat" >nul
if errorlevel 1 goto :no_vcvars

REM ---- locate cppwinrt projection headers (not on default include path) ----
set "CPPWINRT_INC=%WindowsSdkDir%Include\%WindowsSdkVer%cppwinrt"
if exist "%CPPWINRT_INC%\winrt\base.h" goto :have_cppwinrt
set "CPPWINRT_INC=%WindowsSdkDir%Include\10.0.26100.0\cppwinrt"
if exist "%CPPWINRT_INC%\winrt\base.h" goto :have_cppwinrt
echo [ERROR] cppwinrt headers not found. Install the "C++ /WinRT" SDK component.
exit /b 1
:have_cppwinrt
echo [INFO] cppwinrt: "%CPPWINRT_INC%"
REM pass via INCLUDE env var: putting a path containing "(x86)" on the cl
REM command line inside a FOR block can break cmd.exe paren matching
set "INCLUDE=%CPPWINRT_INC%;%INCLUDE%"

goto :build

:no_vswhere
echo [ERROR] vswhere.exe not found. Install Visual Studio Build Tools 2022.
exit /b 1

:no_vcvars
echo [ERROR] vcvars64 initialization failed.
exit /b 1

:build
REM Separate output name and object dir so a beta build can never
REM overwrite the official build, and the two never share objects
REM compiled with different preprocessor flags.
set "OUT=build"
set "OBJDIR=%OUT%\beta_obj"
set "EXE=%OUT%\PaintingBuddyBeta.exe"
if not exist "%OUT%" mkdir "%OUT%"
if not exist "%OBJDIR%" mkdir "%OBJDIR%"

REM ---- unique build version ------------------------------------
REM Every package needs its own version stamp: main.cpp compares it
REM against %LOCALAPPDATA%\PaintingBuddyBeta.version to decide whether
REM this exact package has already run on this machine. Same stamp ->
REM keep the tester's data; new stamp -> clean on first launch.
REM
REM A timestamp gives one unique id per build_beta.bat invocation.
REM Note wmic is gone on recent Windows 11, so use PowerShell.
REM
REM Deliberately NO silent fallback: if the stamp cannot be produced
REM we fail the build instead of shipping a package whose version
REM equals the previous one, which would silently skip cleanup and
REM hand testers stale logs/settings/recordings.
set "BETAVER="
for /f "usebackq delims=" %%v in (`powershell -NoProfile -Command "Get-Date -Format yyyyMMdd_HHmmss"`) do set "BETAVER=%%v"
if not defined BETAVER goto :no_version
set "BETAVER=v%BETAVER%"
set "HDR=src\BetaVersion.h"

echo.
echo ==== GENERATING VERSION HEADER ====
echo   %HDR%  [ %BETAVER% ]
> "%HDR%" echo #pragma once
>>"%HDR%" echo.
>>"%HDR%" echo // Generated by build_beta.bat - do not edit by hand.
>>"%HDR%" echo // Unique per beta package; drives the first-run data cleanup.
>>"%HDR%" echo #define PB_BETA_VERSION "%BETAVER%"

REM /utf-8 : sources contain UTF-8 Chinese string literals
REM /bigobj: C++/WinRT projections exceed the default object section limit
REM /DPB_BETA: enables the beta-only first-run cleanup in main.cpp
set "CXXFLAGS=/nologo /std:c++17 /EHsc /W3 /O2 /MT /utf-8 /bigobj /DUNICODE /D_UNICODE /DNOMINMAX /DWIN32_LEAN_AND_MEAN /D_WIN32_WINNT=0x0A00 /DPB_BETA /Isrc /Fo%OBJDIR%\ /c"
set "LDFLAGS=/nologo /SUBSYSTEM:WINDOWS /INCREMENTAL:NO /OUT:%EXE%"
set "LIBS=user32.lib gdi32.lib shell32.lib ole32.lib oleaut32.lib advapi32.lib d2d1.lib dwrite.lib d3d11.lib dxgi.lib dwmapi.lib shlwapi.lib windowscodecs.lib mf.lib mfplat.lib mfreadwrite.lib mfuuid.lib runtimeobject.lib windowsapp.lib hid.lib winmm.lib comctl32.lib uxtheme.lib propsys.lib"

set "SRCS="
for %%f in (src\*.cpp) do set "SRCS=!SRCS! %%f"

if /i "%~1"=="rebuild" del /q "%OBJDIR%\*.obj" "%OBJDIR%\app.res" 2>nul

REM ---- resource file: embeds res\app.ico into the beta exe --------
REM Must mirror build.bat exactly, otherwise testers get a package
REM whose exe icon differs from the official build. See build.bat for
REM the longer explanation of why the icon has to be a PE resource.
REM /i src : app.rc includes "resource.h" from its own directory, and
REM rc resolves includes against the current directory (project root).
REM Kept out of parenthesized blocks: %WindowsSdkDir% contains "(x86)".
set "RESFILE=%OBJDIR%\app.res"
if not exist "res\app.ico" goto :no_icon
echo.
echo ==== COMPILING RESOURCES ====
echo   src\app.rc
rc /nologo /i src /fo "%RESFILE%" "src\app.rc"
if errorlevel 1 goto :rc_failed

set FAILED=0
echo.
echo ==== COMPILING BETA ====
for %%f in (!SRCS!) do (
    echo   %%f
    cl %CXXFLAGS% "%%f"
    if errorlevel 1 set FAILED=1
)
if "%FAILED%"=="1" goto :compile_failed

echo.
echo ==== LINKING BETA ====
REM app.res listed explicitly: the glob below only collects *.obj, so
REM the resource would be silently omitted and the beta exe would lose
REM its icon without any build error.
set OBJS=
for %%f in ("%OBJDIR%\*.obj") do set "OBJS=!OBJS! %%f"
link %LDFLAGS% !OBJS! "%RESFILE%" %LIBS%
if errorlevel 1 goto :link_failed

echo.
echo [OK] %CD%\%EXE%
echo [OK] beta version %BETAVER%
echo.
echo This is the BETA build. The FIRST launch of this package on a
echo machine moves the existing %%LOCALAPPDATA%%\PaintingBuddy folder
echo to the Recycle Bin, then recreates it, so testers start clean
echo (no logs / settings / event streams / recording cache left over
echo from an earlier package). Later launches of the SAME package keep
echo the data. A newly built package cleans again on its first launch.
echo To force another cleanup, delete
echo %%LOCALAPPDATA%%\PaintingBuddyBeta.version
endlocal
exit /b 0

:no_version
echo.
echo [ERROR] could not produce a build version stamp.
echo PowerShell Get-Date failed; refusing to build because a package
echo without a unique version would silently skip the first-run cleanup.
endlocal
exit /b 1

:compile_failed
echo.
echo [FAILED] compile errors; link aborted.
endlocal
exit /b 1

:rc_failed
echo.
echo [FAILED] resource compile (rc.exe) failed; link aborted.
echo          Check src\app.rc and src\resource.h, and make sure
echo          rc.exe is available (Visual Studio Build Tools SDK).
endlocal
exit /b 1

:no_icon
echo.
echo [FAILED] res\app.ico is missing; refusing to build.
echo          Without it the beta exe would ship with the generic blank
echo          icon in Explorer (desktop / Start menu / taskbar pin), and
echo          the failure would be silent because the sources still
echo          compile. Regenerate the icon per the icon spec, then rebuild.
endlocal
exit /b 1

:link_failed
echo.
echo [FAILED] link errors.
endlocal
exit /b 1
